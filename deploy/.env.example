# 后端容器环境变量模板。服务器上：cp .env.example .env → 填真值（.env 不进仓库）。
# 前端高德 Key 不在这里，在 frontend/.env.local。
# 本地开发不用此文件：后端读仓库根目录的 .env。

# ---------- MySQL ----------
# 端口填宿主机发布端口 53306（容器内 3306 未发布，填 3306 会 Connection refused）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=53306
MYSQL_DATABASE=visit_db
MYSQL_USER=root
MYSQL_PASSWORD=填你的数据库口令
# 连接池上限，4G 服务器 / 1G 容器下的实测值
MYSQL_POOL_MAX=10

# ---------- Redis ----------
# 同样填宿主机发布端口 6479
REDIS_HOST=host.docker.internal
REDIS_PORT=6479
# 固定 DB 3，与服务器上其他项目隔离，不要改成 0
REDIS_DATABASE=3
# 无密码留空
REDIS_PASSWORD=

# ---------- 口令门 ----------
# 改这个值后所有已登录会话立即失效
ACCESS_PASSWORD=填一个足够长的随机串
# 登录状态保持天数
SESSION_DAYS=7

# ---------- 域名与图片 ----------
# 对外站点地址，结尾不带斜杠
BASE_URL=https://visit.sean.ltd
# CDN 前缀 = 图片域名 + 项目前缀；最终 URL 形如 https://images.sean.ltd/visit/2026/10/x_l.jpg
# 本地开发必须留空（拿相对路径 /uploads/... 走 Vite 代理）
CDN_BASE_URL=https://images.sean.ltd/visit

# ---------- 上传 ----------
# 容器内路径，必须与 docker-compose.yml 里 volume 的右侧一致
UPLOAD_DIR=/app/uploads
# 单张图上限（MB），前端已压到 1280px，这里只是兜底
UPLOAD_MAX_MB=15

# ---------- 高德（后端）----------
# 仅当后端要调高德 Web 服务 API 时才填
AMAP_WEB_KEY=

# ---------- 运行环境 ----------
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
# 必须与 Dockerfile 的 EXPOSE、compose 的端口映射一致
SERVER_PORT=8811
