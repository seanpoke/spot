# =============================================================================
# 前端环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制成 .env.local（本文件不进仓库，.env.local 已被 .gitignore 排除）
#   PowerShell : Copy-Item .env.example .env.local
#   bash       : cp .env.example .env.local
#
# 这些值在【构建时】被替换进 JS，会打进 dist，天然公开 —— 所以只放公开也没关系的值。
# 后端口令、数据库账号不在这里（见仓库根目录的 .env）。
# =============================================================================

# 高德 JS API Key（2.0）
VITE_AMAP_KEY=

# 高德安全密钥：必须把 visit.sean.ltd 加入 referer 白名单，否则本地能跑、线上白屏
VITE_AMAP_SECURITY_CODE=

# 地图样式 ID（可选，留空 = 内置 whitesmoke 浅色底图）
# 想完全按 PRD 5.7 的六色底图，去高德控制台「自定义地图」建样式后填 amap://styles/<样式ID>
VITE_AMAP_STYLE=
