<?xml version="1.0" encoding="utf-8"?>
<!--
  明文流量的唯一开口：本地调试。

  壳在调试模式下会把 server.url 指向 http://localhost:5173（PC 上的 dev server，
  经 adb reverse 转发过来），Android 9+ 默认禁止明文，不放行就是白屏。

  这里只放行 localhost / 127.0.0.1 / 10.0.2.2（模拟器里的宿主机），
  其余域名继续走 Android 默认策略（强制 HTTPS）。
  比在 <application> 上写 usesCleartextTraffic="true" 干净：那个是把整个 App 的明文都放开。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
